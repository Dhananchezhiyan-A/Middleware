{
  "name": "lead-middleware",
  "version": "0.1.0",
  "private": true,
  "description": "Lead Integration & Distribution Middleware — production-grade single-application lead processing platform",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm build:packages && concurrently -n api,worker,web -c blue,magenta,green \"pnpm --filter @middleware/api dev\" \"pnpm --filter @middleware/worker dev\" \"pnpm --filter @middleware/web dev\"",
    "dev:api": "pnpm --filter @middleware/api dev",
    "dev:worker": "pnpm --filter @middleware/worker dev",
    "dev:web": "pnpm --filter @middleware/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:queue",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:queue": "vitest run --config vitest.queue.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "bullmq": "^6.3.10",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "ioredis": "^5.11.1",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
